# ---------------------------------------------------------------------------
# ZHAGARAM EXIM - combined project (frontend + API in one codebase)
# Copy to .env and fill in. `cp .env.example .env`
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# DATABASE_URL is what the app queries: use the POOLED string in production
# (Neon's "-pooler" host, Supabase port 6543, or PgBouncer).
# DIRECT_URL is the UNPOOLED string, used for migrations and seeding -- DDL
# through a transaction-mode pooler fails or hangs.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zhagaram"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/zhagaram"

# Set to 1 to stop the deploy build from running `prisma migrate deploy`
# (the `vercel-build` script). Leave unset to let deploys migrate themselves.
SKIP_DB_MIGRATE=""

# --- Auth -----------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
ADMIN_NAME="Administrator"

# --- API server -----------------------------------------------------------
PORT="4000"

# APP_URL is NOT cosmetic. Product pages are server-rendered, and the SSR pass
# needs an absolute origin to call its own /api routes -- without one, the
# catalogue silently falls back to the static sample products in
# src/data/products.ts. Set it to the deployed origin in production.
APP_URL="http://localhost:3000"
PUBLIC_SITE_URL="http://localhost:3000"

# Extra browser origins allowed to call the API, comma separated.
# Leave EMPTY for the combined single-origin setup - the site and the API are
# served from the same host, so no cross-origin request is ever made.
FRONTEND_URL=""

# --- Frontend -------------------------------------------------------------
# LEAVE THIS EMPTY. Empty means the app calls /api/... on its own origin,
# which is the whole point of merging the two projects: no CORS preflight,
# no second DNS + TLS handshake on every request.
# Only set it if you ever deploy the API to a different domain again.
VITE_API_URL=""

VITE_AUTH_ENABLED="true"

# --- Email ----------------------------------------------------------------
# Resend API key. Only the enquiry form needs it -- the rest of the API now
# starts and runs fine without it (server/mailer.ts checks the key when it
# actually sends, not at import time).
RESEND_API_KEY=""
MAIL_FROM="noreply@yourdomain.com"
MAIL_TO="sales@yourdomain.com"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
